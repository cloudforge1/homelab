#!/usr/bin/env bash
# cf — Homelab CLI homelab status, health, and uptime monitor
#
# Usage:
#   cf0              — Full status dashboard
#   cf0 --uptime     — Uptime summary only
#   cf0 --health     — HTTP health probes only
#   cf0 --stacks     — Compose project summary only
#   cf0 --endpoints  — Endpoint URLs only
#   cf0 --json       — Machine-readable JSON output
#   cf0 --watch      — Live watch mode (refresh every 5s)
#   cf --help       — This help
#
set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
