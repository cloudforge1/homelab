{
  "name": "@mvat/prisma",
  "version": "1.0.0",
  "description": "mVat Multi-Database Prisma Implementation with 1+N Architecture",
  "main": "index.js",
  "workspaces": [
    "dbs/global",
    "dbs/entity"
  ],
  "scripts": {
    "postinstall": "echo 'Prisma postinstall: Skipping generate to prevent infinite loop'",
    "install:workspaces": "npm install --workspaces",
    "generate": "npm run generate:global && npm run generate:entity && npm run fix:class-validator",
    "generate:global": "npm run generate --workspace=dbs/global",
    "generate:entity": "npm run generate --workspace=dbs/entity",
    "fix:class-validator": "tsx scripts/fix-class-validator-imports.ts",
    "generate:watch": "npm run generate:global:watch & npm run generate:entity:watch",
    "generate:global:watch": "npm run generate --workspace=dbs/global -- --watch",
    "generate:entity:watch": "npm run generate --workspace=dbs/entity -- --watch",
    "migrate:dev": "npm run migrate:dev --workspaces",
    "migrate:dev:global": "npm run migrate:dev --workspace=dbs/global",
    "migrate:dev:entity": "npm run migrate:dev --workspace=dbs/entity",
    "migrate:deploy": "npm run migrate:deploy --workspaces",
    "migrate:deploy:global": "npm run migrate:deploy --workspace=dbs/global",
    "migrate:deploy:entity": "npm run migrate:deploy --workspace=dbs/entity",
    "migrate:reset": "npm run migrate:reset --workspaces",
    "migrate:reset:global": "npm run migrate:reset --workspace=dbs/global",
    "migrate:reset:entity": "npm run migrate:reset --workspace=dbs/entity",
    "studio": "npm run studio:global & npm run studio:entity",
    "studio:global": "npm run studio --workspace=dbs/global -- --port 5555",
    "studio:entity": "npm run studio --workspace=dbs/entity -- --port 5556",
    "db:push": "npm run db:push --workspaces",
    "db:push:global": "npm run db:push --workspace=dbs/global",
    "db:push:entity": "npm run db:push --workspace=dbs/entity",
    "db:pull": "npm run db:pull --workspaces",
    "db:pull:global": "npm run db:pull --workspace=dbs/global",
    "db:pull:entity": "npm run db:pull --workspace=dbs/entity",
    "seed": "npm run seed:global && npm run seed:entity",
    "seed:global": "tsx seed.ts --global-only --verbose",
    "seed:entity": "tsx seed.ts --entity-only --verbose",
    "build": "echo 'Prisma package: No production TypeScript to build - uses tsx for runtime'",
    "start": "node dist/test.js",
    "clean": "rimraf dist schemas/*/generated node_modules/.prisma",
    "format": "npm run format --workspaces",
    "validate": "npm run validate --workspaces",
    "validate:global": "npm run validate --workspace=dbs/global",
    "validate:entity": "npm run validate --workspace=dbs/entity",
    "validate:entity:views": "npm run validate:views --workspace=dbs/entity",
    "validate:entity:seeding": "npm run validate:seeding --workspace=dbs/entity",
    "validate:entity:views:direct": "npm run validate:views:direct --workspace=dbs/entity",
    "test:entity:comprehensive": "npm run test:comprehensive --workspace=dbs/entity",
    "introspect": "npm run db:pull",
    "deploy": "npm run build && npm run migrate:deploy",
    "install:updates": "ncu -u"
  },
  "keywords": [
    "prisma",
    "multi-database",
    "sql-server",
    "typescript",
    "mvat",
    "polish-vat",
    "jpk",
    "financial-records"
  ],
  "author": "mVat Development Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-mssql": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "prisma": "^7.2.0",
    "prisma-class-validator-generator": "file:./prisma-class-validator-generator-7.0.0.tgz",
    "prisma-json-types-generator": "^4.0.1",
    "prisma-openapi": "^1.3.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  }
}