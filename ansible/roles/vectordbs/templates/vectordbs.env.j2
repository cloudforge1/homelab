# cf0 Vector Databases Stack — Ansible managed
# Do not edit manually; changes will be overwritten.

# ── Chroma ──────────────────────────────────────────────────────────
CHROMA_VERSION={{ chroma_version }}
CHROMA_AUTH_TOKEN={{ chroma_auth_token }}
CHROMA_AUTH_PROVIDER={{ chroma_auth_provider }}
CHROMA_AUTH_HEADER={{ chroma_auth_header }}

# ── Weaviate ────────────────────────────────────────────────────────
WEAVIATE_VERSION={{ weaviate_version }}
WEAVIATE_QUERY_LIMIT={{ weaviate_query_limit }}
WEAVIATE_ANON_ACCESS={{ weaviate_anon_access | lower }}
WEAVIATE_VECTORIZER={{ weaviate_vectorizer }}
WEAVIATE_MODULES={{ weaviate_modules }}
WEAVIATE_APIKEY_ENABLED={{ weaviate_apikey_enabled | lower }}
WEAVIATE_APIKEYS={{ weaviate_apikeys }}
WEAVIATE_APIKEY_USERS={{ weaviate_apikey_users }}
WEAVIATE_ADMINLIST_ENABLED={{ weaviate_adminlist_enabled | lower }}
WEAVIATE_ADMIN_USERS={{ weaviate_admin_users }}

# ── Milvus ──────────────────────────────────────────────────────────
MILVUS_VERSION={{ milvus_version }}
MINIO_VERSION={{ minio_version }}
MILVIO_MINIO_ACCESS_KEY={{ milvus_minio_access_key }}
MILVIO_MINIO_SECRET_KEY={{ milvus_minio_secret_key }}
