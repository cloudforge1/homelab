# ===================================================================
# AI Tools Environment Variables
# Categories: OCR, Speech, TTS, Audio, Translation, Image, Code,
#             Gateway, Video, RAG, Email, Privacy, Memory, NSFW, Notable
#
# States:
#   "running"  — Deploy + start (consumes RAM, binds port)
#   "stopped"  — Pull image + create container, keep stopped (0 RAM, 0 CPU, image on disk)
#   "disabled" — Not deployed at all
#
# Hardware: cf0 — i9-9900K (16t), 107GB RAM, GTX 1060 6GB (Pascal SM 6.1)
# HARD BLOCKERS:
#   - vLLM GPU mode: needs SM 8.0+ (Ampere); Pascal SM 6.1 blocked
#   - Rope: RTX/tensor core optimizations; Pascal too slow
#   - kohya_ss: LoRA training needs 8+ GB VRAM
#   - Email tools: need port 25 + DNS/MX/SSL
# ===================================================================

# ── Document OCR & Understanding ────────────────────────────────────
# HW: CPU-friendly. GLM-OCR needs LLM backend (Ollama).
ENABLE_GLM_OCR=stopped
ENABLE_PADDLE_OCR=stopped
ENABLE_MARKER=stopped

# ── Speech-to-Text (Transcription) ─────────────────────────────────
# HW: All easy. Small/medium models fit 6GB VRAM; CPU works too.
ENABLE_FASTER_WHISPER=stopped
ENABLE_WHISPER_X=stopped
ENABLE_FUNASR=stopped

# ── Text-to-Speech (TTS) ───────────────────────────────────────────
# HW: All CPU-only/lightweight. Piper = <100ms on CPU.
ENABLE_PIPER=stopped
ENABLE_KOKORO_FASTAPI=stopped
ENABLE_PADDLE_SPEECH=stopped

# ── Audio Separation & Processing ──────────────────────────────────
# HW: CPU-friendly. 107GB RAM handles models easily.
ENABLE_DEMUCS=stopped
ENABLE_UVR5=stopped
ENABLE_AUDIOSEP=stopped

# ── Translation ─────────────────────────────────────────────────────
# HW: CPU-first. Lightweight models, no GPU needed.
ENABLE_PDF_MATH_TRANSLATE=stopped
ENABLE_LIBRE_TRANSLATE=stopped
ENABLE_ARGOS_TRANSLATE=stopped

# ── Image Generation ────────────────────────────────────────────────
# HW: POSSIBLE — SD 1.5 OK on 6GB; SDXL needs --lowvram.
ENABLE_COMFYUI=stopped
ENABLE_FOOOCUS=stopped
ENABLE_SWARMUI=stopped

# ── Image Enhancement & Restoration ────────────────────────────────
# HW: Easy. Tile-based keeps VRAM low. Fits 6GB fine.
ENABLE_REAL_ESRGAN=stopped
ENABLE_GFPGAN=stopped
ENABLE_CLARITY_UPSCALER=stopped

# ── AI Code Assistant ──────────────────────────────────────────────
# HW: Aider routes to Ollama. Tabby = small models only, slow on CPU.
ENABLE_AIDER=stopped
ENABLE_TABBY=stopped

# ── LLM Gateway & Routing ──────────────────────────────────────────
# HW: Easy — pure proxy/observability, no ML inference.
ENABLE_LITELLM=stopped
ENABLE_LANGFUSE=stopped
ENABLE_INFINITY=stopped

# ── Video Download & Processing ────────────────────────────────────
# HW: Easy — no ML, just yt-dlp + ffmpeg.
ENABLE_COBALT=stopped
ENABLE_METUBE=stopped
ENABLE_RECLIP=stopped

# ── RAG & Document Chat ────────────────────────────────────────────
# HW: Easy — route to existing Ollama + Qdrant/Chroma.
ENABLE_PRIVATEGPT=stopped
ENABLE_ANYTHINGLLM=stopped
ENABLE_PAPERQA2=stopped

# ── Email Privacy ──────────────────────────────────────────────────
# ⚠️ BLOCKER: Needs port 25 + DNS/MX/SSL setup.
ENABLE_ANONADDY=stopped
ENABLE_SIMPLELOGIN=stopped
ENABLE_MAILU=stopped

# ── Privacy & Anonymization ────────────────────────────────────────
# HW: Easy — CPU-only pattern matching.
ENABLE_PRESIDIO=stopped
ENABLE_SECRET_SCANNER=stopped
ENABLE_PII_DETECTOR=stopped

# ── AI Memory & Cognitive ──────────────────────────────────────────
# HW: Easy — route to existing Ollama + Qdrant.
ENABLE_MEM0=stopped
ENABLE_LETTA=stopped
# Cognee is already deployed in cf-core (port 8000)

# ── NSFW / 18+ Tools ───────────────────────────────────────────────
# FaceFusion/RVC/Applio/AnimateDiff: POSSIBLE (inference OK, training slow)
# ⚠️ BLOCKED: Rope (RTX tensor cores), kohya_ss (8+ GB VRAM training)
ENABLE_FUSION=stopped
ENABLE_ROPE=stopped                # BLOCKED: needs RTX tensor cores
ENABLE_RVC=stopped
ENABLE_APPLIO=stopped
ENABLE_BARK=stopped
ENABLE_KOHYA=stopped               # BLOCKED: needs 8+ GB VRAM for training
ENABLE_ANIMATEDIFF=stopped
ENABLE_DEEPFACELIVE=stopped        # Real-time deepfake for video calls
ENABLE_ROOP_DISCONTINUED=stopped   # Original one-click face swap (forked to FaceFusion)
ENABLE_MOORE_ANIMATEANYONE=stopped # Pose-driven character animation
ENABLE_MAGICANIMATE=stopped        # Densepose-guided human animation
ENABLE_AI_TOOLKIT=stopped          # Microsoft's LoRA training toolkit
ENABLE_STABILITY_MATRIX=stopped    # Package manager for SD UIs

# ── Also Notable (Optional) ────────────────────────────────────────
# HW: Easy or lightweight. Auto1111 runs SD 1.5 fine on 6GB.
ENABLE_SURYA=stopped
ENABLE_DOCLING=stopped
ENABLE_NOUGAT=stopped              # PDF → Markdown (academic papers)
ENABLE_WHISPER_CPP=stopped
ENABLE_SPEECHBRAIN=stopped          # Speech toolkit (ASR, TTS, speaker)
ENABLE_COQUI_TTS=stopped            # TTS (no longer maintained but functional)
ENABLE_EDGE_TTS=stopped             # Zero-GPU TTS via Edge Online TTS API
ENABLE_SPLEETER=stopped             # Audio stem separation (outdated by Demucs)
ENABLE_INVOKEAI=stopped             # SD image gen (polished, 27k stars)
ENABLE_CODEFORMER=stopped           # Face restoration (alternative to GFPGAN)
ENABLE_SWINIR=stopped               # Image restoration (alternative to ESRGAN)
ENABLE_SGLANG=stopped               # LLM serving (alt to vLLM; ⚠️ may need SM 8.0)
ENABLE_TENSORRT_LLM=stopped         # NVIDIA TensorRT LLM (⚠️ BLOCKED: SM 8.0+)
ENABLE_SMARTER_ROUTER=stopped       # VRAM-aware LLM routing
ENABLE_YT_DLP_WEB_UI=stopped        # NAS-friendly yt-dlp web UI
ENABLE_STALWART=stopped             # Modern mail server (alt to Mailu)
ENABLE_POSTAL=stopped               # Transactional mail server
ENABLE_OPENSANCTIONS=stopped        # Org/person screening
ENABLE_GOPHISH=stopped              # Phishing simulation/testing
ENABLE_RECALLIUM=stopped            # AI memory (minimal, 28 stars)
ENABLE_ZENII=stopped                # 20MB memory brain (minimal, 16 stars)
ENABLE_AUTO1111=stopped
ENABLE_TUBEARCHIVIST=stopped
ENABLE_DIFY=stopped
ENABLE_BLOOP=stopped

