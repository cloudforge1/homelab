# cf0 Stack Environment Configuration
# Copy to .env and edit values as needed.

# ── OpenRAG ──────────────────────────────────────────────────────────
OPENRAG_VERSION=latest
OPENSEARCH_PASSWORD=changeme_generateA1!
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_INDEX_NAME=documents
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_WORKERS=1
FRONTEND_PORT=3000

# ── Vector DBs (Chroma, Weaviate, Milvus) ───────────────────────────
CHROMA_VERSION=latest
CHROMA_AUTH_TOKEN=
CHROMA_AUTH_PROVIDER=
CHROMA_AUTH_HEADER=
WEAVIATE_VERSION=1.27.0
WEAVIATE_QUERY_LIMIT=25
WEAVIATE_ANON_ACCESS=true
WEAVIATE_VECTORIZER=none
WEAVIATE_MODULES=text2vec-openai,text2vec-cohere,text2vec-huggingface,generative-openai,generative-cohere,qna-openai,reranker-cohere
WEAVIATE_APIKEY_ENABLED=false
WEAVIATE_APIKEYS=
WEAVIATE_ADMINLIST_ENABLED=false
WEAVIATE_ADMIN_USERS=
MILVUS_VERSION=v2.5.0
MINIO_VERSION=latest
MILVIO_MINIO_ACCESS_KEY=minioadmin
MILVIO_MINIO_SECRET_KEY=minioadmin
