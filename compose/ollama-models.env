# cf0 optional slow-model sync flags for Ollama
# Used by: cf0-stack.sh model-sync
#
# Set a flag to true to pull that model during the next sync run.
# Leave false to skip it.
#
# Intentionally omitted as older/superseded duplicates:
# - devstral-small-2
# - olmo-3
# - glm-4.6
# - glm-4.7
# - qwen3-coder

MODEL_SYNC_TIMEOUT_SECS=1800

ENABLE_MODEL_NEMOTRON_3_SUPER=false
ENABLE_MODEL_QWEN3_CODER_NEXT=false
ENABLE_MODEL_DEVSTRAL_2=false
ENABLE_MODEL_NEMOTRON_CASCADE_2=false
ENABLE_MODEL_NEMOTRON_3_NANO_30B=false
ENABLE_MODEL_QWEN3_VL_30B=false
ENABLE_MODEL_QWEN3_VL_8B=false
ENABLE_MODEL_LFM2_24B=false
ENABLE_MODEL_GLM_4_7_FLASH=false
ENABLE_MODEL_QWEN3_NEXT=false
ENABLE_MODEL_GPT_OSS_20B=false
ENABLE_MODEL_OLMO_3_1_32B=false
ENABLE_MODEL_QWEN35_9B=true
ENABLE_MODEL_QWEN35_122B=false
