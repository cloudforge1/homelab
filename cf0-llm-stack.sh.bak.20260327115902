#!/usr/bin/env bash
# cf0-llm-stack.sh — Docker-based Local LLM + AI Tools Infrastructure for cf0
# All services run as Docker containers — safe to interrupt/resume.
# Run as: sudo -E bash /opt/cf0-scripts/cf0-llm-stack.sh
#
# Hardware: i9-9900K (16 threads, AVX2), 107GB RAM, GTX 1060 6GB, 492GB /home
# Network: 100 Mbps ethernet — limited to 50 Mbps (50%) during setup
#
# Services:
#   Step  0: Bandwidth limit (50mbit)
#   Step  1: Ollama          — inference runtime           (port 11434)
#   Step  2: Open WebUI      — chat interface              (port 8080)
#   Step  3: SearXNG         — private search              (port 8081)
#   Step  4: OpenRAG         — agentic RAG (Langflow)      (port 3000)
#   Step  5: MindsDB         — AI database gateway         (port 47334/47335)
#   Step  6: Cognee          — AI memory knowledge engine  (port 8083)
#   Step  7: ZeroClaw        — personal AI assistant       (port 42617)
#   Step  8: CLI tools       — Claude Code, MetaClaw, Unsloth
#   Step  9: Pull models
#   Step 10: System tuning
#   Step 11: Firewall
#   Step 12: Convenience scripts + aliases
#   Step 13: Remove bandwidth limit
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
LOGFILE="/var/log/cf0-llm-stack.log"
LOCAL_USER="${SUDO_USER:-r}"
LOCAL_HOME=$(eval echo "~$LOCAL_USER")
NIC="eno1"
BW_LIMIT="50mbit"  # 50% of 100 Mbps link
COMPOSE_DIR="/opt/cf0-scripts/compose"

log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOGFILE"; }
run_as_user() { sudo -u "$LOCAL_USER" -E bash -c "$*"; }

HEALTH_FAILURES=0
# Health-check a service: wait for HTTP 2xx/3xx or TCP connect
# Usage: health_check <name> <port> [path] [max_seconds]
health_check() {
    local name="$1" port="$2" path="${3:-/}" max="${4:-20}"
    local url="http://127.0.0.1:${port}${path}"
    for i in $(seq 1 "$max"); do
        if curl -sf -o /dev/null -w '' --max-time 3 "$url" 2>/dev/null; then
            log "  ✓ ${name} healthy (port ${port})"
            return 0
        fi
        sleep 1
    done
    # Fallback: check if port is at least listening (some services don't return 2xx on /)
    if ss -tlnp | grep -q ":${port} " 2>/dev/null; then
        log "  ⚠ ${name} port ${port} listening but HTTP check failed — may still be starting"
        return 0
    fi
    log "  ✗ ${name} NOT responding on port ${port} — check: docker logs ${name}"
    ((HEALTH_FAILURES++)) || true
    return 0
}

# Check if a container is genuinely running (not restarting/crash-looping).
# If crash-looping (>3 restarts), remove it so the fresh-install branch recreates it.
# Usage: container_ok <name>  →  returns 0 if truly running, 1 if absent/broken/removed
container_ok() {
    local name="$1"
    if ! docker ps -a --format '{{.Names}}' | grep -q "^${name}$"; then
        return 1  # doesn't exist at all
    fi
    local state
    state=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null || echo "unknown")
    if [[ "$state" == "running" ]]; then
        local rc
        rc=$(docker inspect --format '{{.RestartCount}}' "$name" 2>/dev/null || echo "0")
        if [[ "${rc:-0}" -gt 3 ]]; then
            log "  ${name} crash-looping (${rc} restarts) — removing for recreation"
            docker rm -f "$name" 2>/dev/null || true
            return 1
        fi
        return 0
    elif [[ "$state" == "restarting" ]]; then
        local rc
        rc=$(docker inspect --format '{{.RestartCount}}' "$name" 2>/dev/null || echo "0")
        log "  ${name} is restarting (${rc} restarts) — removing for recreation"
        docker rm -f "$name" 2>/dev/null || true
        return 1
    else
        # exited, dead, created, etc — remove stale container
        docker rm -f "$name" 2>/dev/null || true
        return 1
    fi
}


# ─────────────────────────────────────────────────────────────────
#  PREFLIGHT CHECKS
# ─────────────────────────────────────────────────────────────────
log "╔══════════════════════════════════════════════════════════════╗"
log "║       cf0 Docker LLM + AI Tools Stack                       ║"
log "║       i9-9900K · 107GB RAM · GTX 1060 6GB                   ║"
log "║       Bandwidth limit: ${BW_LIMIT} on ${NIC}                ║"
log "╚══════════════════════════════════════════════════════════════╝"

if [[ $EUID -ne 0 ]]; then echo "ERROR: Run with sudo -E"; exit 1; fi

for cmd in docker curl; do
    command -v "$cmd" &>/dev/null || { log "ERROR: $cmd not found — run cf0-setup.sh first"; exit 1; }
done
log "Prerequisites OK (docker, curl found)"

# Check NVIDIA driver + container toolkit
if command -v nvidia-smi &>/dev/null; then
    GPU_INFO=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "N/A")
    log "GPU detected: $GPU_INFO"
    HAS_GPU=true
else
    log "WARNING: No NVIDIA driver detected — GPU inference will be skipped"
    HAS_GPU=false
fi

if ! docker info 2>/dev/null | grep -q "nvidia"; then
    if dpkg -l nvidia-container-toolkit &>/dev/null; then
        log "nvidia-container-toolkit installed, configuring Docker runtime..."
        nvidia-ctk runtime configure --runtime=docker
        systemctl restart docker
        sleep 3
    else
        log "WARNING: nvidia-container-toolkit not found — GPU containers won't work"
        HAS_GPU=false
    fi
fi

TOTAL_RAM_GB=$(awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo)
CPU_THREADS=$(nproc)
log "RAM: ${TOTAL_RAM_GB}GB | CPU: ${CPU_THREADS} threads | AVX2: $(grep -q avx2 /proc/cpuinfo && echo YES || echo NO)"

# Ensure compose dir exists
mkdir -p "$COMPOSE_DIR"

# ═════════════════════════════════════════════════════════════════════
#  0. BANDWIDTH LIMITING — 50% of link speed
# ═════════════════════════════════════════════════════════════════════
log "=== Step 0: Bandwidth check (${NIC}) ==="

if command -v tc &>/dev/null; then
    if tc class show dev "$NIC" 2>/dev/null | grep -q 'rate'; then
        CURRENT_RATE=$(tc class show dev "$NIC" 2>/dev/null | grep -oP 'rate \S+' | head -1)
        log "Bandwidth limit already active ($CURRENT_RATE) — not overriding"
    else
        tc qdisc del dev "$NIC" root 2>/dev/null || true
        tc qdisc add dev "$NIC" root handle 1: htb default 10
        tc class add dev "$NIC" parent 1: classid 1:10 htb rate "${BW_LIMIT}" ceil "${BW_LIMIT}" burst 32k quantum 1514
        tc qdisc add dev "$NIC" parent 1:10 handle 10: fq_codel
        log "No existing limit — applied ${BW_LIMIT} on ${NIC}"
    fi
    log "  (Manage with: pnpm bw:25 / bw:40 / bw:off  on cfx002)"
else
    log "WARNING: tc not found — bandwidth limiting skipped"
fi

# ═════════════════════════════════════════════════════════════════════
#  1. OLLAMA — Primary inference runtime (Docker)
# ═════════════════════════════════════════════════════════════════════
log "=== Step 1: Ollama (Docker container) ==="

# Clean up any leftover bare-metal install
if [[ -f /usr/local/bin/ollama ]]; then
    log "Removing bare-metal Ollama binary..."
    rm -f /usr/local/bin/ollama
fi
if [[ -f /etc/systemd/system/ollama.service ]]; then
    log "Removing bare-metal Ollama systemd service..."
    systemctl stop ollama 2>/dev/null || true
    systemctl disable ollama 2>/dev/null || true
    rm -f /etc/systemd/system/ollama.service
    systemctl daemon-reload
fi

# Model storage on RAID0
mkdir -p /home/r/.ollama/models
chown -R "$LOCAL_USER:$LOCAL_USER" /home/r/.ollama

if docker ps --format '{{.Names}}' | grep -q '^ollama$'; then
    log "Ollama container already running"
elif docker ps -a --format '{{.Names}}' | grep -q '^ollama$'; then
    log "Ollama container stopped — starting..."
    docker start ollama
    sleep 3
else
    log "Creating Ollama container..."
    GPU_FLAG=""
    if [[ "$HAS_GPU" == "true" ]]; then
        GPU_FLAG="--gpus all"
    fi
    docker run -d \
        --name ollama \
        --restart unless-stopped \
        $GPU_FLAG \
        --network host \
        -v /home/r/.ollama:/root/.ollama \
        -e OLLAMA_NUM_PARALLEL=2 \
        -e OLLAMA_KEEP_ALIVE=30m \
        -e OLLAMA_HOST=0.0.0.0:11434 \
        -e OLLAMA_MAX_LOADED_MODELS=3 \
        -e OLLAMA_FLASH_ATTENTION=1 \
        -e OLLAMA_NUM_THREADS=14 \
        ollama/ollama:latest
    sleep 5
fi

# Wait for API
for i in $(seq 1 15); do
    if curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        OLLAMA_VER=$(docker exec ollama ollama --version 2>&1 | tail -1)
        log "Ollama API up — $OLLAMA_VER"
        break
    fi
    sleep 2
done
if ! curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    log "ERROR: Ollama API not responding — check: docker logs ollama"
    exit 1
fi

# ═════════════════════════════════════════════════════════════════════
#  2. OPEN WEBUI — Chat interface (Docker)
# ═════════════════════════════════════════════════════════════════════
log "=== Step 2: Open WebUI (Docker container) ==="

if container_ok open-webui; then
    log "Open WebUI running"
    health_check "open-webui" 8080 "/" 10
elif docker ps -a --format '{{.Names}}' | grep -q '^open-webui$'; then
    log "Open WebUI stopped — starting..."
    docker start open-webui
else
    docker run -d \
        --name open-webui \
        --restart unless-stopped \
        --network host \
        -v open-webui-data:/app/backend/data \
        -e OLLAMA_BASE_URL=http://127.0.0.1:11434 \
        -e WEBUI_AUTH=false \
        -e OPENAI_API_BASE_URLS="https://api.deepseek.com/v1;https://api.moonshot.cn/v1;https://openrouter.ai/api/v1" \
        -e OPENAI_API_KEYS="sk-DEEPSEEK_KEY;sk-KIMI_KEY;sk-or-OPENROUTER_KEY" \
        ghcr.io/open-webui/open-webui:main
    sleep 5
    health_check "open-webui" 8080 "/" 30
fi

# ═════════════════════════════════════════════════════════════════════
#  3. SEARXNG — Private search engine (Docker, for Open WebUI RAG)
# ═════════════════════════════════════════════════════════════════════
log "=== Step 3: SearXNG (Docker container) ==="

if container_ok searxng; then
    log "SearXNG running"
    health_check "searxng" 8081 "/" 10
elif docker ps -a --format '{{.Names}}' | grep -q '^searxng$'; then
    log "SearXNG stopped — starting..."
    docker start searxng
else
    mkdir -p /home/r/searxng
    docker run -d \
        --name searxng \
        --restart unless-stopped \
        -p 8081:8080 \
        -v /home/r/searxng:/etc/searxng \
        -e SEARXNG_BASE_URL=http://localhost:8081/ \
        docker.io/searxng/searxng:latest
    sleep 3
    health_check "searxng" 8081 "/" 20
    log "  → Configure in Open WebUI: Settings > Web Search > SearXNG URL = http://127.0.0.1:8081"
fi

# ═════════════════════════════════════════════════════════════════════
#  4. OPENRAG — Agentic RAG (Langflow + OpenSearch + Docling)
#     langflow-ai/openrag (3.5K stars, Apache 2.0)
#     Docker Compose: opensearch, dashboards, langflow, backend, frontend
# ═════════════════════════════════════════════════════════════════════
log "=== Step 4: OpenRAG (Docker Compose) ==="

OPENRAG_DIR="/home/r/openrag"
OPENRAG_ENV="$OPENRAG_DIR/.env"

if docker ps --format '{{.Names}}' | grep -q 'openrag-frontend'; then
    log "OpenRAG already running"
    health_check "openrag" 3000 "/" 10
elif docker ps -a --format '{{.Names}}' | grep -q 'openrag-frontend'; then
    log "OpenRAG stopped — starting..."
    (cd "$OPENRAG_DIR" && docker compose up -d)
else
    log "Setting up OpenRAG (langflow-ai/openrag)..."
    if [[ ! -d "$OPENRAG_DIR/.git" ]]; then
        run_as_user "git clone --depth 1 https://github.com/langflow-ai/openrag.git '$OPENRAG_DIR'"
    fi

    # Create .env if missing — generate a secure OpenSearch password
    if [[ ! -f "$OPENRAG_ENV" ]]; then
        OPENSEARCH_PW=$(openssl rand -base64 16 | tr -d '/+=' | head -c20)
        cat > "$OPENRAG_ENV" << ENVEOF
OPENSEARCH_PASSWORD=${OPENSEARCH_PW}A1!
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=${OPENSEARCH_PW}
FRONTEND_PORT=3000
OPENRAG_VERSION=latest
ENVEOF
        chown "$LOCAL_USER:$LOCAL_USER" "$OPENRAG_ENV"
        log "OpenRAG .env created (OpenSearch password auto-generated)"
    fi

    (cd "$OPENRAG_DIR" && docker compose up -d) 2>&1 | tail -5 | tee -a "$LOGFILE"
    health_check "openrag" 3000 "/" 30
fi

# ═════════════════════════════════════════════════════════════════════
#  5. MINDSDB — AI database gateway (Docker)
#     mindsdb/mindsdb (38.8K stars)
#     HTTP API on 47334, MySQL-compatible on 47335
# ═════════════════════════════════════════════════════════════════════
log "=== Step 5: MindsDB (Docker container) ==="

if container_ok mindsdb; then
    log "MindsDB running"
    health_check "mindsdb" 47334 "/api/status" 10
elif docker ps -a --format '{{.Names}}' | grep -q '^mindsdb$'; then
    log "MindsDB stopped — starting..."
    docker start mindsdb
    sleep 5
    health_check "mindsdb" 47334 "/api/status" 15
else
    mkdir -p /home/r/mindsdb
    # Create minimal config if missing (MindsDB crashes without it)
    if [[ ! -f /home/r/mindsdb/mindsdb_config.json ]]; then
        cat > /home/r/mindsdb/mindsdb_config.json << 'MINDSCONF'
{
  "config_version": "1.4",
  "storage_dir": "/root/mindsdb_storage",
  "api": {
    "http": {"host": "0.0.0.0", "port": 47334},
    "mysql": {"host": "0.0.0.0", "port": 47335}
  }
}
MINDSCONF
        chown "$LOCAL_USER:$LOCAL_USER" /home/r/mindsdb/mindsdb_config.json
        log "MindsDB config created"
    fi
    docker run -d \
        --name mindsdb \
        --restart unless-stopped \
        -p 47334:47334 \
        -p 47335:47335 \
        -v /home/r/mindsdb:/root \
        mindsdb/mindsdb:latest
    sleep 5
    health_check "mindsdb" 47334 "/api/status" 30
fi

# ═════════════════════════════════════════════════════════════════════
#  6. COGNEE — AI memory knowledge engine (Docker Compose)
#     topoteretes/cognee (14.5K stars, Apache 2.0)
#     API server + optional Neo4j
# ═════════════════════════════════════════════════════════════════════
log "=== Step 6: Cognee (Docker Compose) ==="

COGNEE_DIR="/home/r/cognee"

if docker ps --format '{{.Names}}' | grep -q 'cognee'; then
    log "Cognee already running"
    health_check "cognee" 8000 "/" 15
elif docker ps -a --format '{{.Names}}' | grep -q 'cognee'; then
    log "Cognee stopped — starting..."
    (cd "$COGNEE_DIR" && docker compose up -d)
else
    log "Setting up Cognee..."
    if [[ ! -d "$COGNEE_DIR/.git" ]]; then
        run_as_user "git clone --depth 1 https://github.com/topoteretes/cognee.git '$COGNEE_DIR'"
    fi

    # Create .env from template
    if [[ ! -f "$COGNEE_DIR/.env" ]] && [[ -f "$COGNEE_DIR/.env.template" ]]; then
        cp "$COGNEE_DIR/.env.template" "$COGNEE_DIR/.env"
        # Fix bare-dash separator lines that break Docker Compose env parser
        sed -i 's/^--*\s.*$/# &/' "$COGNEE_DIR/.env"
        chown "$LOCAL_USER:$LOCAL_USER" "$COGNEE_DIR/.env"
        log "Cognee .env created from template (sanitized) — edit to set LLM_API_KEY"
    fi

    # Use pre-built image instead of building from source
    # (source Dockerfile apt-get update fails on stale base image repos)
    cd "$COGNEE_DIR"
    # Remove build: directives, add image: lines
    sed -i '/^    build:/d; /^      context:/d; /^      dockerfile:/d' docker-compose.yml
    grep -q 'image:' docker-compose.yml 2>/dev/null || \
        sed -i '/^  cognee:$/a\\    image: cognee/cognee:latest' docker-compose.yml
    docker compose pull 2>&1 | tail -3 | tee -a "$LOGFILE"
    docker compose up -d 2>&1 | tail -5 | tee -a "$LOGFILE"
    cd - >/dev/null
    health_check "cognee" 8000 "/" 30
    log "Cognee started â API: http://0.0.0.0:8000 (pre-built image)"
fi

# ═════════════════════════════════════════════════════════════════════
#  7. ZEROCLAW — Personal AI assistant (Docker)
#     zeroclaw-labs/zeroclaw (28.3K stars, MIT/Apache-2.0)
#     Rust binary, gateway on port 42617, web dashboard included
# ═════════════════════════════════════════════════════════════════════
log "=== Step 7: ZeroClaw (Docker container) ==="

if container_ok zeroclaw; then
    log "ZeroClaw running"
    health_check "zeroclaw" 42617 "/" 10
elif docker ps -a --format '{{.Names}}' | grep -q '^zeroclaw$'; then
    log "ZeroClaw stopped — starting..."
    docker start zeroclaw
else
    mkdir -p /home/r/.zeroclaw
    chown "$LOCAL_USER:$LOCAL_USER" /home/r/.zeroclaw

    docker run -d \
        --name zeroclaw \
        --restart unless-stopped \
        -p 42617:42617 \
        -v /home/r/.zeroclaw:/root/.zeroclaw \
        -e ZEROCLAW_HOST=0.0.0.0 \
        ghcr.io/zeroclaw-labs/zeroclaw:latest \
        gateway start -p 42617 --host 0.0.0.0
    sleep 3
    health_check "zeroclaw" 42617 "/" 20
fi

# ═════════════════════════════════════════════════════════════════════
#  8. CLI TOOLS — Non-Docker tools installed natively
#     - Node.js + Claude Code (npm)
#     - MetaClaw (pip)
#     - Unsloth (pip, inference only on GTX 1060)
# ═════════════════════════════════════════════════════════════════════
log "=== Step 8: CLI tools (Node.js, Claude Code, MetaClaw, Unsloth) ==="

# --- Node.js (needed for Claude Code) ---
if ! command -v node &>/dev/null; then
    log "Installing Node.js 22 LTS..."
    if [[ -f /etc/apt/keyrings/nodesource.gpg ]]; then
        log "NodeSource repo already configured"
    else
        mkdir -p /etc/apt/keyrings
        curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
        echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list
    fi
    apt-get update -qq && apt-get install -y -qq nodejs
    log "Node.js $(node --version) installed"
else
    log "Node.js already installed: $(node --version)"
fi

# --- Claude Code (npm global) ---
if command -v claude &>/dev/null; then
    log "Claude Code already installed: $(claude --version 2>&1 | head -1)"
else
    log "Installing Claude Code..."
    npm install -g @anthropic-ai/claude-code 2>&1 | tail -3 | tee -a "$LOGFILE"
    if command -v claude &>/dev/null; then
        log "Claude Code installed: $(claude --version 2>&1 | head -1)"
    else
        log "WARNING: Claude Code install failed (may need API key setup later)"
    fi
fi

# --- AI tools venv (PEP 668 — system pip refuses library installs) ---
AI_VENV="/home/r/.ai-tools-venv"
if [[ ! -d "$AI_VENV" ]]; then
    log "Creating AI tools venv at $AI_VENV..."
    run_as_user "python3 -m venv '$AI_VENV'"
fi
AI_PIP="$AI_VENV/bin/pip"

# --- MetaClaw ---
if "$AI_VENV/bin/python3" -c "import metaclaw" 2>/dev/null; then
    log "MetaClaw already installed"
else
    log "Installing MetaClaw..."
    run_as_user "'$AI_PIP' install metaclaw" 2>&1 | tail -3 | tee -a "$LOGFILE"
    [[ -f "$AI_VENV/bin/metaclaw" ]] && ln -sf "$AI_VENV/bin/metaclaw" /usr/local/bin/metaclaw 2>/dev/null || true
    log "MetaClaw installed — run: metaclaw setup"
fi

# --- Unsloth (inference only — GTX 1060 SM6.1 can't train) ---
if "$AI_VENV/bin/python3" -c "import unsloth" 2>/dev/null; then
    log "Unsloth already installed"
else
    log "Installing Unsloth (inference only)..."
    run_as_user "'$AI_PIP' install unsloth" 2>&1 | tail -3 | tee -a "$LOGFILE"
    [[ -f "$AI_VENV/bin/unsloth" ]] && ln -sf "$AI_VENV/bin/unsloth" /usr/local/bin/unsloth 2>/dev/null || true
    log "Unsloth installed (inference mode — GTX 1060 too old for training)"
fi

# ═════════════════════════════════════════════════════════════════════
#  9. PULL MODELS — All tiers, unattended
# ═════════════════════════════════════════════════════════════════════
log "=== Step 9: Pull models via Ollama (Docker) ==="
log ""
log "Model plan: 107GB RAM + GTX 1060 6GB + 100Mbps @ 50%"
log "  50 Mbps ~ 6.25 MB/s -> 2.6GB model ~7min, 42GB model ~112min"
log ""

pull_model() {
    local name="$1" tier="$2" desc="$3"
    if docker exec ollama ollama list 2>/dev/null | grep -q "^${name}"; then
        log "  [${tier}] ${name} — already pulled"
        return 0
    fi
    log "  [${tier}] Pulling ${name} (${desc})..."
    if docker exec ollama ollama pull "$name" 2>&1 | tee -a "$LOGFILE"; then
        log "  [${tier}] ${name} — done"
    else
        log "  [${tier}] ${name} — FAILED (will retry next run)"
        return 1
    fi
}

PULL_FAILURES=0

# Tier 1 — GPU essentials (must-have)
log "-- TIER 1: GPU models (<6GB VRAM) --"
pull_model "qwen3.5:4b"         "T1" "~2.6GB best small model"       || ((PULL_FAILURES++))
pull_model "nomic-embed-text"    "T1" "~275MB embeddings/RAG"         || ((PULL_FAILURES++))
pull_model "deepseek-r1:8b"     "T1" "~4.9GB reasoning"              || ((PULL_FAILURES++))

# Tier 2 — CPU/GPU split (good all-rounders)
log "-- TIER 2: Medium models (CPU/GPU split) --"
pull_model "qwen3.5:27b"        "T2" "~16GB strong all-rounder"      || ((PULL_FAILURES++))
pull_model "deepseek-r1:32b"    "T2" "~19GB best mid reasoning"      || ((PULL_FAILURES++))
pull_model "codestral:22b"      "T2" "~13GB coding specialist"       || ((PULL_FAILURES++))

# Tier 3 — CPU big brain
log "-- TIER 3: Big CPU models --"
pull_model "qwen3.5:35b"        "T3" "~24GB MoE 35B-A3B, only 3B active"  || ((PULL_FAILURES++))
pull_model "deepseek-r1:70b"    "T3" "~40GB best reasoning"          || ((PULL_FAILURES++))
pull_model "llama3.1:70b"       "T3" "~40GB Meta's best"             || ((PULL_FAILURES++))

log ""
log "Model pulls complete. Failures: ${PULL_FAILURES}"

# ═════════════════════════════════════════════════════════════════════
#  10. SYSTEM TUNING — Optimize for LLM workloads
# ═════════════════════════════════════════════════════════════════════
log "=== Step 10: System tuning ==="

if ! grep -q 'vm.max_map_count=1048576' /etc/sysctl.d/99-llm.conf 2>/dev/null; then
    cat > /etc/sysctl.d/99-llm.conf << 'EOF'
# LLM inference + OpenSearch tuning
vm.max_map_count=1048576
fs.file-max=1048576
vm.swappiness=10
vm.dirty_ratio=40
vm.dirty_background_ratio=10
EOF
    sysctl -p /etc/sysctl.d/99-llm.conf
    log "Kernel tuning applied"
else
    log "Kernel tuning already applied"
fi

if [[ -f /sys/kernel/mm/transparent_hugepage/enabled ]]; then
    echo madvise > /sys/kernel/mm/transparent_hugepage/enabled
fi

if ! grep -q "$LOCAL_USER.*nofile" /etc/security/limits.d/99-llm.conf 2>/dev/null; then
    cat > /etc/security/limits.d/99-llm.conf << EOF
$LOCAL_USER soft nofile 65536
$LOCAL_USER hard nofile 65536
$LOCAL_USER soft memlock unlimited
$LOCAL_USER hard memlock unlimited
EOF
    log "User limits set"
fi

